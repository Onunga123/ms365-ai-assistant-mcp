CLIENT_ID=your-azure-app-client-id
TENANT_ID=your-azure-tenant-id
CLIENT_SECRET=your-azure-app-client-secret
MCP_API_KEY=choose-a-long-random-secure-key
SECRET_EXPIRY_DATE=YYYY-MM-DD
REDACT_PII=true
VERBOSE_LOGGING=false
SILENT=false
EMAIL_BODY_FORMAT=text
MAX_TOP=200
ALERT_EMAIL=your-alert-sender-email@gmail.com
ALERT_EMAIL_PASSWORD=your-app-specific-password
ALERT_RECIPIENT=your-admin-email@example.com

# Optional settings (the application uses these defaults when the variable is unset or empty):
# Default IANA timezone for calendar and To-Do event creation.
DEFAULT_TIMEZONE=Africa/Nairobi
# SMTP server for operational alert emails.
SMTP_HOST=smtp.gmail.com
# SMTP port for operational alert emails (must be an integer in 1-65535).
SMTP_PORT=465